@model IReadOnlyList<Merchant>
@{
    ViewData["Title"] = "Мерчанты";
    var isProd = Context.Session.GetString("Environment:IsProd") == "true";
}

<div class="page-heading">
    <div><div class="eyebrow">@(isProd ? "PROD · облачный API" : "DEV · localhost")</div><h1>Мерчанты</h1><p class="muted">В каждом окружении свой список. Ключи хранятся зашифрованными.</p></div>
    <a class="btn primary" asp-action="Edit" asp-route-prod="@isProd">+ Добавить мерчанта</a>
</div>

@if (Model.Count == 0)
{
    <section class="card empty-state"><h2>Пока пусто</h2><p class="muted">Добавьте первый набор API-ключей.</p></section>
}
else
{
    <div class="merchant-grid">
        @foreach (var merchant in Model)
        {
            <article class="card merchant-card">
                <div class="merchant-title"><div><h2>@merchant.Name</h2><div class="muted mono small">@merchant.BaseUrl</div></div><span class="badge">#@merchant.Id</span></div>
                <dl class="key-list"><div><dt>TEST</dt><dd>@merchant.TestApiKeyMasked</dd></div><div><dt>API</dt><dd>@merchant.LiveApiKeyMasked</dd></div></dl>
                <div class="button-row">
                    <a class="btn primary" asp-action="Dashboard" asp-route-id="@merchant.Id" asp-route-prod="@merchant.IsProd">Открыть</a>
                    <a class="btn secondary" asp-action="Edit" asp-route-id="@merchant.Id">Изменить</a>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Удалить мерчанта и его историю?')"><input type="hidden" name="id" value="@merchant.Id" /><button class="btn danger ghost" type="submit">Удалить</button></form>
                </div>
            </article>
        }
    </div>
}
