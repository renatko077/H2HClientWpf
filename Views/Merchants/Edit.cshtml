@model Merchant
@{ ViewData["Title"] = Model.Id == 0 ? "Новый мерчант" : "Изменить мерчанта"; }

<div class="page-heading compact"><div><div class="eyebrow">Настройки</div><h1>@ViewData["Title"]</h1></div><a class="btn secondary" asp-action="Index">Назад</a></div>
<section class="card form-card">
    <form asp-action="Edit" method="post" class="form-stack">
        <input asp-for="Id" type="hidden" />
        <input asp-for="IsProd" type="hidden" />
        <div class="alert warning-text">Контур: <strong>@(Model.IsProd ? "PROD · облачный API" : "DEV · localhost")</strong></div>
        <div asp-validation-summary="ModelOnly" class="alert error"></div>
        <div class="form-grid">
            <div class="field span-2"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span></div>
            <div class="field span-2"><label asp-for="BaseUrl"></label><input asp-for="BaseUrl" placeholder="https://localhost:7056" /><span asp-validation-for="BaseUrl" class="field-error"></span></div>
            <div class="field"><label asp-for="TestApiKey"></label><input asp-for="TestApiKey" autocomplete="off" /><span asp-validation-for="TestApiKey" class="field-error"></span></div>
            <div class="field"><label asp-for="LiveApiKey"></label><input asp-for="LiveApiKey" autocomplete="off" /></div>
            <div class="field span-2"><label asp-for="Secret"></label><input asp-for="Secret" type="password" autocomplete="new-password" /><span asp-validation-for="Secret" class="field-error"></span></div>
        </div>
        @if (Model.Id > 0) { <p class="hint">Оставьте ключи пустыми, чтобы сохранить текущие значения.</p> }
        <div class="button-row"><button class="btn primary" type="submit">Сохранить</button><a class="btn secondary" asp-action="Index">Отмена</a></div>
    </form>
</section>
